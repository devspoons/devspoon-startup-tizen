# log files #
*.log 
log/

# OS Files #
*.swp

# web root #
# www/

# nginx cache #
nginx_cache/

# ssl files
**/ssl/

# data
compose/web_service/nginx_gunicorn/ssl/
compose/web_service/nginx_gunicorn/redis/
compose/web_service/nginx_php/ssl/
compose/web_service/nginx_php/redis/
compose/web_service/nginx_uwsgi/ssl/
compose/web_service/nginx_uwsgi/redis/

# Redis 실시간 dump (테스트/운영 중 컨테이너가 생성) — 모든 스택 공통
# .gitkeep 은 negation 으로 유지 (디렉터리 자체는 트리 상에 보존)
**/redis/data/*
!**/redis/data/.gitkeep

# ---------------------------------------------------------------------------
# .env — 자격증명 보호
# - compose/**/.env 는 FLOWER_BASIC_AUTH, REDIS_PASSWORD 등을 포함
# - 운영 자격증명은 git 추적 대상에서 제외하고, 동일 폴더의 .env-example 만 추적
# ---------------------------------------------------------------------------
**/.env
!**/.env-example

# Python / uv virtualenv (컨테이너가 mount 된 /www 안에 생성)
**/.venv/
**/__pycache__/
*.py[cod]
*.egg-info/

# ---------------------------------------------------------------------------
# 런타임 SQLite DB / 시크릿 파일은 추적 금지.
# - secrets.json 은 .example 패턴 또는 env 주입으로 관리 권장.
# ---------------------------------------------------------------------------
www/*/db.sqlite3
www/*/secrets.json
*.sqlite3

# 사용자별 proxy conf 복사본(.example·마운트 자리표시자 default.conf 만 추적)
config/web-server/nginx/php/proxy/*/*.conf
!config/web-server/nginx/php/proxy/*/default.conf

# docs/YYYY-MM-DD/ — 날짜별 로컬 작업 문서(학습·설계·작업계획·체크리스트·리포트). git 추적 제외.
docs/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# 형제 전용 런타임 데이터(Jenkins home) — 내용물 무시, 빈 자리표시자 .gitkeep 만 추적 (SRV1-SEC-01, D-PH)
# Plane·Gitea 의 데이터(pgdata·uploads·저장소·sqlite)는 호스트 폴더가 아니라 named volume 이라 무시 규칙이 필요 없다.
compose/master_service/jenkins_home/*
!compose/master_service/jenkins_home/.gitkeep
compose/project_mng_service/nginx_jenkins/jenkins_home/*
!compose/project_mng_service/nginx_jenkins/jenkins_home/.gitkeep
# Harbor ssl — autoinstall.sh 가 폴더째 cp 하므로 폴더는 유지, 인증서 내용물은 무시·빈 .gitkeep 만 추적 (D-PH)
!compose/project_mng_service/harbor-v2.0.0/ssl/
compose/project_mng_service/harbor-v2.0.0/ssl/*
!compose/project_mng_service/harbor-v2.0.0/ssl/.gitkeep
# ensure_env_secrets 원자 교체 임시 파일(mktemp .env.XXXXXX) — 강제 종료로 남아도 추적 안 함 (.env.example 은 7자라 비매칭)
# 주의: 6글자 확장자 .env.* 를 추적해야 하면(예: .env.sample) 아래에 `!` 예외를 추가
**/.env.??????

# docs/livetest/ · docs/logs/ — 라이브 테스트 하네스와 원본 로그는 로컬 전용(보고서 .md 만 추적).
# 위 !docs/** negation 보다 뒤에 있어야 적용된다(마지막 매칭 규칙 우선).
docs/livetest/
docs/logs/
