# =============================================================================
# master_service 환경변수 (template) — docker-compose-{daphne,gunicorn,uvicorn,uwsgi,php}.yml 공용
# - .env 로 복사한 뒤 비밀값(빈 값)을 한 번에 무작위 생성 — 공개 예시 자격증명은 두지 않는다 (저장소 루트에서):
#     bash -c '. script/lib/django_secrets.sh && ensure_env_secrets compose/master_service/.env'
#   (compose 가 :? 로 요구하는 비밀 키 DJANGO_SECRET_KEY·REDIS_PASSWORD·FLOWER_PWD·PLANE_SECRET_KEY·PLANE_LIVE_SERVER_SECRET_KEY·PLANE_DB_PASSWORD·PLANE_MQ_PASSWORD·PLANE_MINIO_PASSWORD 를 생성, 기존 값은 불변)
# - .env 는 .gitignore 에 의해 git 추적 대상에서 제외됨 (이 파일만 추적)
# =============================================================================

# ── Project ─────────────────────────────────────────────────────────────────
PROJECT_DIR=django_sample
WORKERS=4
GUNICORN_PORT=8000
REQUIREMENTS=./requirements.txt
PROJECT_NAME=django_sample

# ── Django (django_sample) ─────────────────────────────────────────────────
# 기본은 운영 안전값. 로컬 개발에서만 DJANGO_DEBUG=1. 도메인 연결 시 ALLOWED_HOSTS 에 추가.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,www.localhost,127.0.0.1
# SECRET_KEY — 필수. 비워 두면 compose 가 기동을 거부한다 — 파일 머리의 ensure_env_secrets 한 줄로 생성.
DJANGO_SECRET_KEY=

# ── Logging (docker compose log driver) ────────────────────────────────────
# compose 측 ${VAR:-default} 와 이중 안전. .env 키 누락 시에도 빈 문자열 미전달.
LOG_DRIVER=json-file
LOG_OPT_MAXF=5
LOG_OPT_MAXS=100m

# ── Redis / Celery 자격증명 (SSOT) ─────────────────────────────────────────
# REDIS_PASSWORD 한 값으로 redis / celery / celery-beat / flower 가 모두 동기화된다.
#  - compose 의 redis 컨테이너 command 에 --requirepass 로 주입
#  - celery / celery-beat / flower 의 CELERY_BROKER_URL 은 compose 에서
#    redis://:${REDIS_PASSWORD}@redis:6379/3 형태로 합성되어 .env 에 따로 두지 않음
#    → 두 값 drift 가 구조적으로 불가능 (한 곳만 갱신).
REDIS_PASSWORD=

# ── Flower Basic Auth ──────────────────────────────────────────────────────
# flower 는 호스트 로컬(127.0.0.1:5555)에만 바인드된다 — 원격 접근은 SSH 터널(ssh -L 5555:127.0.0.1:5555 <host>).
# 그래도 브라우저로 여는 관리 화면이므로 반드시 강한 자격증명으로 교체할 것.
FLOWER_ID=CHANGE_ME_FLOWER_USER
FLOWER_PWD=

# ── ulimits (현재 비활성, 변수만 정의) ──────────────────────────────────────
# nginx.conf 의 `worker_rlimit_nofile 65535` 와 호환되는 호스트측 ulimits 값.
# compose 의 webserver 서비스에 ulimits 블록을 두었으나 의도적으로 주석 처리해
# 실제로는 docker daemon 기본값(LimitNOFILE, 통상 1048576)을 사용한다.
# 호스트 OS (RHEL/podman 등) 에서 기본값이 다른 경우에만 compose 의 주석을 풀어 활성.
ULIMIT_NOFILE_SOFT=65535
ULIMIT_NOFILE_HARD=65535

# ── Plane (프로젝트 관리, makeplane/plane) ─────────────────────────────────
# 도메인·URL 은 proxy conf(config/web-server/nginx/php/proxy/plane/plane_proxy.conf)의
# server_name 과 반드시 같아야 한다. 비밀값(빈 값)은 파일 머리의 ensure_env_secrets 한 줄로 생성.
PLANE_DOMAIN=plane.example.com
PLANE_WEB_URL=http://plane.example.com
PLANE_CORS_ALLOWED_ORIGINS=http://plane.example.com
PLANE_RELEASE=stable
PLANE_SECRET_KEY=
PLANE_LIVE_SERVER_SECRET_KEY=
PLANE_DB_PASSWORD=
PLANE_MQ_PASSWORD=
PLANE_MINIO_PASSWORD=
PLANE_DB_USER=plane
PLANE_DB_NAME=plane
PLANE_MQ_USER=plane
PLANE_MQ_VHOST=plane
PLANE_MINIO_USER=plane-minio
# MinIO 이미지(기본 quay.io 고정 — Docker Hub minio/minio 는 익명 pull 불가)
#PLANE_MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
PLANE_BUCKET_NAME=uploads
PLANE_FILE_SIZE_LIMIT=5242880
PLANE_GUNICORN_WORKERS=1
PLANE_DEBUG=0

# ── Gitea (git 서버, go-gitea/gitea) ───────────────────────────────────────
# 관리자 계정은 최초 기동 후 만든다:
#   docker compose -f docker-compose-<stack>.yml exec -u git gitea \
#     gitea admin user create --username <id> --password <pw> --email <mail> --admin
GITEA_DOMAIN=gitea.example.com
GITEA_ROOT_URL=http://gitea.example.com/
GITEA_RELEASE=1.27
GITEA_SSH_PORT=2222
#GITEA_SSH_BIND=127.0.0.1
GITEA_DISABLE_REGISTRATION=true
GITEA_REQUIRE_SIGNIN_VIEW=false
GITEA_DB_TYPE=sqlite3
# tizenenv (docker-compose-php.yml 전용) — 키는 저장소 밖 호스트 파일 (D-7)
# 호스트의 Tizen Gerrit(review.tizen.org) 개인키 경로 (chmod 600)
TIZEN_SSH_KEY=~/.ssh/tizen_id_rsa
# 컨테이너 root 로 접속할 공개키 목록 파일 경로 (chmod 600, root 소유 — sshd StrictModes)
TIZEN_AUTHORIZED_KEYS=~/.ssh/tizen_authorized_keys
# 원격 접속을 허용할 때만 해제 (기본 127.0.0.1)
#TIZEN_SSH_BIND=0.0.0.0
