# =============================================================================
# 단독 Gitea 스택 환경변수 (template)
# - .env 로 복사해 도메인을 입력한다(비밀값 없음 — 관리자 계정은 최초 기동 후 아래 명령으로 만든다):
#     docker compose exec -u git gitea gitea admin user create \
#       --username <id> --password <pw> --email <mail> --admin
# - GITEA_DOMAIN · GITEA_ROOT_URL 은 proxy conf 의 server_name 과 같은 도메인으로 맞춘다.
# =============================================================================

LOG_DRIVER=json-file
LOG_OPT_MAXF=5
LOG_OPT_MAXS=100m

# ── Gitea 도메인 (자리표시자 — 직접 입력) ───────────────────────────────────
GITEA_DOMAIN=gitea.example.com
GITEA_ROOT_URL=http://gitea.example.com/
# SSH 클론 URL 에 표기될 도메인(미설정 시 GITEA_DOMAIN)
#GITEA_SSH_DOMAIN=gitea.example.com

# ── Gitea 이미지·포트 ───────────────────────────────────────────────────────
GITEA_RELEASE=1.27
# git over SSH 호스트 포트(기존 gitolite 와 동일한 2222). 바인드 주소 기본 0.0.0.0
GITEA_SSH_PORT=2222
#GITEA_SSH_BIND=127.0.0.1

# ── Gitea 정책 ──────────────────────────────────────────────────────────────
# 자체 가입 허용하려면 false (기본은 관리자만 계정 생성)
GITEA_DISABLE_REGISTRATION=true
GITEA_REQUIRE_SIGNIN_VIEW=false
GITEA_DB_TYPE=sqlite3
