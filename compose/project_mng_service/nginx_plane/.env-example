# =============================================================================
# 단독 Plane 스택 환경변수 (template)
# - .env 로 복사한 뒤 비밀값(빈 값)을 한 번에 무작위 생성 — 공개 예시 자격증명은 두지 않는다 (저장소 루트에서):
#     bash -c '. script/lib/django_secrets.sh && ensure_env_secrets compose/project_mng_service/nginx_plane/.env'
#   (이름에 SECRET·PASSWORD·PWD 가 들어간 키를 무작위 값으로 채운다 — include 한 compose/common/ 정의의 키도 대상)
# - PLANE_DOMAIN · PLANE_WEB_URL · PLANE_CORS_ALLOWED_ORIGINS 는 proxy conf 의 server_name 과 같은 도메인으로 직접 입력한다.
# =============================================================================

LOG_DRIVER=json-file
LOG_OPT_MAXF=5
LOG_OPT_MAXS=100m

# ── Plane 도메인 (자리표시자 — 직접 입력) ───────────────────────────────────
PLANE_DOMAIN=plane.example.com
PLANE_WEB_URL=http://plane.example.com
PLANE_CORS_ALLOWED_ORIGINS=http://plane.example.com

# ── Plane 이미지 태그 ───────────────────────────────────────────────────────
PLANE_RELEASE=stable

# ── Plane 비밀값 (필수 — 비워 두면 compose 가 기동을 거부한다) ──────────────
PLANE_SECRET_KEY=
PLANE_LIVE_SERVER_SECRET_KEY=
PLANE_DB_PASSWORD=
PLANE_MQ_PASSWORD=
PLANE_MINIO_PASSWORD=

# ── Plane 기타 (기본값 사용 시 수정 불필요) ─────────────────────────────────
PLANE_DB_USER=plane
PLANE_DB_NAME=plane
PLANE_MQ_USER=plane
PLANE_MQ_VHOST=plane
PLANE_MINIO_USER=plane-minio
# MinIO 이미지(기본 quay.io 고정 — Docker Hub minio/minio 는 익명 pull 불가)
#PLANE_MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
PLANE_BUCKET_NAME=uploads
PLANE_FILE_SIZE_LIMIT=5242880
PLANE_GUNICORN_WORKERS=1
PLANE_DEBUG=0
