# OpenProject reverse proxy sample
# 사용: 이 폴더(config/web-server/nginx/php/proxy/openproject/)에서
#         cp openproject_proxy.conf.example openproject_proxy.conf
#       후 server_name 도메인만 수정. 단독 스택 nginx_openproject 는 이 폴더를 conf.d 로 마운트한다
#       (복사본이 없으면 catch-all default.conf 가 444 로 응답하며 정상 기동).
#       master_service 도 같은 폴더의 복사본을 쓴다 — webserver 가 이 폴더를 /etc/nginx/proxy.d/openproject/ 로 마운트(conf.d 로 복사하지 않음).
#       compose .env 의 OPENPROJECT_HOST_NAME 을 같은 도메인으로 맞춘다.
# 요구: nginx.conf http 블록의 map $http_upgrade $connection_upgrade (WebSocket).
# 주의: proxy_params 가 Host·X-Forwarded-Proto 등·HTTP/1.1·버퍼링을 이미 설정한다.
#       같은 location 에서 그 값을 다시 쓰면 헤더가 2번 전송되거나 "directive is duplicate" 로 기동 실패한다.
server {
    listen 80;
    server_name openproject.example.com;
    include /etc/nginx/bots.d/blockbots.conf;
    include /etc/nginx/bots.d/ddos.conf;

    location /.well-known/acme-challenge/ { root /www/certbot; }

    location / {
        include /etc/nginx/proxy_params;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        client_max_body_size 50m;
        proxy_pass http://openproject:80;
    }
}
